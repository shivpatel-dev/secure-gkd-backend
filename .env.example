# Required. Set a local-only PostgreSQL password in the untracked .env file.
SPRING_DATASOURCE_PASSWORD=

# Required. Set Base64 for at least 32 random bytes in the untracked .env file.
JWT_SIGNING_KEY_BASE64=

# Optional. Omit this variable to retain the application's PT15M default.
# JWT_ACCESS_TOKEN_LIFETIME=PT15M
